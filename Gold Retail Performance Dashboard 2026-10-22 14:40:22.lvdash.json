{
  "datasets": [
    {
      "name": "gold_fact_metrics",
      "displayName": "Gold Fact Metrics",
      "config": {
        "source": "ddev.gold.fact_sales",
        "measures": [
          {
            "displayName": "Net Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              },
              "abbreviation": "compact"
            },
            "name": "revenue",
            "expr": "SUM(net_revenue)",
            "comment": "Sum of net line revenue (extended price less discount)"
          },
          {
            "displayName": "Orders",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "orders",
            "expr": "COUNT(DISTINCT l_orderkey)",
            "comment": "Distinct orders"
          },
          {
            "displayName": "Active Customers",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "active_customers",
            "expr": "COUNT(DISTINCT o_custkey)",
            "comment": "Distinct customers with activity"
          },
          {
            "name": "avg_order_value",
            "expr": "MEASURE(`revenue`) / MEASURE(`orders`)",
            "displayName": "Avg Order Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_discount",
            "expr": "AVG(l_discount)",
            "displayName": "Avg Discount",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_ship_days",
            "expr": "AVG(DATEDIFF(l_receiptdate, l_shipdate))",
            "displayName": "Avg Ship-to-Receipt Days",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "pct_of_revenue",
            "expr": "MEASURE(`revenue`) / ANY_VALUE(total_revenue_all)",
            "displayName": "Percent of Total Revenue",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Gold line-item fact metrics for the Task 8 executive dashboard (ddev.gold tables only)",
        "dimensions": [
          {
            "name": "order_date",
            "expr": "o_orderdate",
            "displayName": "Order Date",
            "comment": "Order placement date (used for trend and date-range filter)"
          },
          {
            "name": "customer_region",
            "expr": "customer_region",
            "displayName": "Customer Region",
            "comment": "Customer geography region"
          },
          {
            "name": "customer_nation",
            "expr": "customer_nation",
            "displayName": "Customer Nation",
            "comment": "Customer nation"
          },
          {
            "name": "market_segment",
            "expr": "c_mktsegment",
            "displayName": "Market Segment",
            "comment": "Customer market segment"
          },
          {
            "name": "customer_name",
            "expr": "customer_name",
            "displayName": "Customer"
          },
          {
            "name": "product_name",
            "expr": "product_name",
            "displayName": "Product"
          },
          {
            "name": "supplier_name",
            "expr": "supplier_name",
            "displayName": "Supplier"
          },
          {
            "name": "ship_mode",
            "expr": "l_shipmode",
            "displayName": "Ship Mode"
          },
          {
            "name": "total_revenue_all",
            "expr": "SUM(net_revenue) OVER ()",
            "displayName": "Total Revenue (All Rows)",
            "comment": "Fixed LOD grand-total revenue used for percent-of-total measures"
          }
        ]
      }
    }
  ],
